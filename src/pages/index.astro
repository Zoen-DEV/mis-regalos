---
import '@fontsource/fredoka/400.css';
import '@fontsource/fredoka/500.css';
import '@fontsource/fredoka/600.css';
import '@fontsource/fredoka/700.css';
import '../styles/global.css';

import Espacio from '../components/Espacio.astro';
import GiftGrid from '../components/GiftGrid';
import { config, regalos } from '../data/regalos';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{config.titulo}</title>
    <meta name="description" content={config.subtitulo} />
    <meta property="og:title" content={config.titulo} />
    <meta property="og:description" content={config.subtitulo} />
    <meta name="theme-color" content="#05040f" />
  </head>
  <body>
    <Espacio />
    <main>
      <!-- Solo para lectores de pantalla: la página no muestra textos -->
      <h1 class="sr-only">{config.titulo}</h1>
      <GiftGrid client:only="react" regalos={regalos} />
    </main>
  </body>
</html>
